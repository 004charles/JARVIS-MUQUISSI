# ==============================================================================
# J.A.R.V.I.S. — Configuração de Ambiente
# Copia este ficheiro para .env e ajusta conforme necessário.
# Nunca faças commit de chaves reais (.env está no .gitignore).
# ==============================================================================

# Aplicação
APP_NAME="Arcanjo"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Servidor Backend (FastAPI)
HOST="127.0.0.1"
PORT=8010
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Base de Dados (SQLite local por omissão)
DATABASE_URL="sqlite:///./data/jarvis.db"

# Inteligência Artificial (Fase 3)
AI_DEFAULT_PROVIDER="groq"
AI_FALLBACK_PROVIDER=""
AI_TIMEOUT=60
AI_MAX_HISTORY_MESSAGES=10
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Para conversa usa um modelo de chat (ex.: qwen2.5:7b, llama3.1:8b), não um "coder".
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT=60

# Providers Externos (Opcional - preencher apenas se utilizados)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
GROQ_API_KEY=""
# Obrigatória para a voz (transcrição Whisper). Grátis em https://console.groq.com
GROQ_MODEL="openai/gpt-oss-120b"

# Segurança e Diretórios Autorizados (Fase 4+)
ALLOWED_DIRECTORIES="/home/carlos-muquissi/JARVIS-MUQUISSI"
REQUIRE_CONFIRMATION_LEVEL_2=true
# Acesso total ao computador: terminal, qualquer app, qualquer pasta.
# Só ações destrutivas (apagar, sudo, matar processos, desligar...) pedem confirmação por voz.
FULL_ACCESS=true

# Cérebro: aprende sozinho factos sobre ti e guarda resumos das conversas
BRAIN_AUTO_MEMORY=true
BRAIN_EPISODE_GAP_MINUTES=30

# Voz (Fase 6)
VOICE_LANGUAGE="pt-PT"
VOICE_ENABLED=false
VOICE_NATIVE_AUTOSTART=true
VOICE_WAKE_WORD="arcanjo"
# Depois de o chamares, continua a ouvir-te sem o nome durante N segundos
VOICE_ACTIVE_WINDOW_SECONDS=60
# Voz: Arcanjo (Duarte, grave) | Muquissi-Mulher (Francisca) | Muquissi-Grave (Duarte, masculina) | pt-BR-AntonioNeural ...
VOICE_TTS_VOICE="Arcanjo"
# wake_word (chamas "Muquissi") | always_reply (responde a tudo) | proactive (comenta a conversa da sala)
VOICE_LISTENING_MODE="always_reply"
# Cérebro da voz: vazio = Groq automático se GROQ_API_KEY existir
VOICE_AI_PROVIDER=""
VOICE_AI_MODEL=""
# Interromper o Muquissi falando por cima (ativa só com auscultadores ou echo-cancel do PipeWire)
VOICE_BARGE_IN=false
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-3.5-flash"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Charon"

# Mente da Muquissi: a câmara é o olho dela, pensa sozinha e decide quando falar
BRAIN_MIND_ENABLED=false
BRAIN_VISION_ENABLED=false
# De quantos em quantos segundos olha (só envia a imagem para análise se a cena mudou)
BRAIN_VISION_INTERVAL_SECONDS=30
BRAIN_THINK_INTERVAL_SECONDS=150
# Intervalo mínimo entre comentários por iniciativa própria (segundos)
BRAIN_MIN_INITIATIVE_GAP_SECONDS=420
# Horas em que não fala por iniciativa (23h às 7h)
BRAIN_QUIET_HOURS="23-7"

# Ganho do microfone (a Muquissi repõe-no se o browser o subir)
VOICE_MIC_VOLUME=0.40
VOICE_MIC_AUTO_GAIN=true

# Sons da Stella (ouvi-te / a pensar / vou falar / erro)
VOICE_SOUND_CUES=true
VOICE_CUE_VOLUME=0.35

# Cancelamento de eco: ela não ouve vídeos/música do PC nem a própria voz; podes interrompê-la
VOICE_ECHO_CANCEL=true
VOICE_BARGE_IN_WITH_AEC=true

# Escolha do cérebro por pergunta (simples → rápido e barato; profundas → o melhor)
AI_ROUTING=true
AI_FAST_MODEL=""
AI_DEEP_MODEL=""

# Limites por pessoa (produto público)
GUARD_QUESTIONS_PER_MINUTE=8
GUARD_QUESTIONS_PER_DAY=300
