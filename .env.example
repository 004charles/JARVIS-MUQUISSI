# ==============================================================================
# J.A.R.V.I.S. — Configuração de Ambiente
# Copia este ficheiro para .env e ajusta conforme necessário.
# Nunca faças commit de chaves reais (.env está no .gitignore).
# ==============================================================================

# Aplicação
APP_NAME="Muquissi"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Servidor Backend (FastAPI)
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Base de Dados (SQLite local por omissão)
DATABASE_URL="sqlite:///./data/jarvis.db"

# Inteligência Artificial (Fase 3)
AI_DEFAULT_PROVIDER="ollama"
AI_FALLBACK_PROVIDER=""
AI_TIMEOUT=60
AI_MAX_HISTORY_MESSAGES=16
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"
OLLAMA_TIMEOUT=60

# Providers Externos (Opcional - preencher apenas se utilizados)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Segurança e Diretórios Autorizados (Fase 4+)
ALLOWED_DIRECTORIES="/home/sckj-muquissi/Documentos/MUQUISSI JARVIS"
REQUIRE_CONFIRMATION_LEVEL_2=true

# Voz (Fase 6)
VOICE_LANGUAGE="pt-PT"
VOICE_ENABLED=false
VOICE_NATIVE_AUTOSTART=true
VOICE_WAKE_WORD="muquissi"
VOICE_ACTIVE_WINDOW_SECONDS=45
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-3.5-flash"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Charon"
